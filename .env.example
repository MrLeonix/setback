# Copy to .env and adjust for local overrides. Never commit the real .env.
# See src/setback/config.py for the defaults these override.
#
# Setback always talks to a real GCP project (Vertex AI + Firestore + GCS) —
# there is no offline/emulator mode. To run this yourself, set these to a
# GCP project of YOUR OWN with the APIs below enabled; don't point at the
# author's project id.
#
# The author's own deployment (referenced throughout STATUS.md/SMOKE.md and
# used for the demo video) runs against project id `vexcourt-agent` — that
# project is not yours to use, and app code only defaults to it as a
# convenience for the author's own local development.

# Your GCP project id. Required APIs: run.googleapis.com,
# artifactregistry.googleapis.com, cloudbuild.googleapis.com,
# firestore.googleapis.com, secretmanager.googleapis.com,
# aiplatform.googleapis.com (see deploy.sh step 1 for the exact list).
SETBACK_GCP_PROJECT=your-gcp-project-id

# Firestore database id. Use "(default)" unless you've created a named
# database (the author's deployment uses a named "setback-au" database in
# australia-southeast1 — see docs/ARCHITECTURE.md §3).
SETBACK_FIRESTORE_DB=(default)

# Region for Cloud Run / Firestore / GCS resources you create.
SETBACK_REGION=australia-southeast1

# GCS bucket for the case corpus (must exist in your project).
SETBACK_GCS_BUCKET=your-project-id-setback-corpus

# GCS bucket for resident-uploaded case evidence (must exist in your
# project; object layout: cases/{case_id}/uploads/{sha256}.{ext}).
SETBACK_GCS_UPLOADS_BUCKET=your-project-id-setback-uploads

# Two further env vars the app reads are deliberately NOT listed above with
# a value to fill in: they are wired only from GCP Secret Manager at deploy
# time (see deploy.sh and docs/ARCHITECTURE.md §5), never from a literal env
# var value, local or deployed. Nothing below is a value to set here.
#   SETBACK_DOCKET_KEY   -- the /docket board's passphrase gate; sourced
#                           from the `docket-key` secret.
#   MAPS_API_KEY         -- the tribunal job's Street View fallback only;
#                           sourced from the `maps-api-key` secret. Not
#                           needed for `make test` / `make run-local`,
#                           which never call Street View.
